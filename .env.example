# ====================================================================
# RouteLess: The Last Mile — Environment Configuration
# ====================================================================

# Port for Backend Express API Server
PORT=3001

# Optional Frontend API Base URL (defaults to direct client solver if empty)
VITE_API_URL=http://localhost:3001

# PostgreSQL + PostGIS Database Connection URL (Optional - in-memory fallback enabled)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/routeless

# Supabase Auth & Storage Integration (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Telematics & GIS Providers (Optional - simulated GPS mode enabled by default)
TRACCAR_API_URL=
AIS140_TELEMATICS_WEBHOOK_SECRET=

# Emergency SMS Gateway (Twilio Adapter)
# If left blank, notifications safely route to the In-App Notification Center
VITE_TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=+1234567890

# Emergency Email Gateway (SendGrid Adapter)
SENDGRID_API_KEY=
NOTIFICATION_FROM_EMAIL=dispatch@routeless.gov.in
